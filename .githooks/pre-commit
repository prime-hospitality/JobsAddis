#!/bin/sh
#
# Blocks a commit that would publish a credential.
#
# This repository is public, and on 2026-07-18 four throwaway scripts went in
# with the Supabase service_role key typed into them as a string. That key
# bypasses row level security entirely, so it stayed readable to anyone for
# eleven days. This hook exists so the next one stops here instead.
#
# Scans only the lines being added, so existing history does not make every
# commit fail.
#
# Installed with `git config core.hooksPath .githooks` -- see README. To bypass
# for a single commit (a documentation example, a test fixture), run
# `git commit --no-verify`, and be certain the string is not real.

if git rev-parse --verify HEAD >/dev/null 2>&1; then
  against=HEAD
else
  against=$(git hash-object -t tree /dev/null)
fi

added=$(git diff --cached --diff-filter=ACM -U0 "$against" | grep '^+' | grep -v '^+++')
[ -n "$added" ] || exit 0

findings=$(mktemp)
trap 'rm -f "$findings"' EXIT

# Placeholders are what .env.example and the docs are made of. Excluding them by
# shape rather than by filename keeps the hook honest if a real key is ever
# pasted into a file that happens to be documentation.
placeholder='your_|_here|<[a-z_]+>|example|placeholder|change_me|redacted|xxx|\.\.\.'

scan() {
  printf '%s\n' "$added" \
    | grep -oE "$1" \
    | grep -viE "$placeholder" \
    | sort -u \
    | while IFS= read -r hit; do
        [ -n "$hit" ] && printf '%s\t%s\t%s\n' "$2" "$(printf '%s' "$hit" | cut -c1-28)" "$3"
      done >> "$findings"
}

# Supabase legacy JWT. anon and service_role share this shape; neither belongs
# in a source file, so both are flagged.
scan 'eyJ[A-Za-z0-9_-]{10,}\.eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}' \
     'Supabase/JWT key' \
     'Read it from process.env or Deno.env -- never inline it.'

scan 'sb_secret_[A-Za-z0-9_-]{12,}' \
     'Supabase secret key' \
     'Belongs in Vercel and Supabase secrets, not the repository.'

scan '[0-9]{8,10}:AA[A-Za-z0-9_-]{30,}' \
     'Telegram bot token' \
     'Belongs in Supabase Edge Function secrets.'

scan 'postgres(ql)?://[^ "'"'"']*:[^ "'"'"'@]+@[^ "'"'"']+' \
     'Database URL with password' \
     'Use SUPABASE_DB_URL from the environment.'

scan '(ghp|gho|ghs|ghu)_[A-Za-z0-9]{30,}' \
     'GitHub token' \
     'Use a GitHub Actions secret.'

scan 'sk-[A-Za-z0-9]{24,}' \
     'API secret key' \
     'Read it from the environment.'

scan 'sk_live_[A-Za-z0-9]{16,}' \
     'Live API secret key' \
     'Read it from the environment.'

# A secret-shaped variable assigned a long literal, for anything the patterns
# above do not recognise by shape.
scan '(SERVICE_ROLE_KEY|SECRET|PASSWORD|TOKEN)[A-Z_]*["'"'"']?\s*[:=]\s*["'"'"'][^"'"'"']{16,}["'"'"']' \
     'Secret assigned a literal' \
     'Move the value to the environment and read it at runtime.'

[ -s "$findings" ] || exit 0

echo ""
echo "  COMMIT BLOCKED -- a credential appears in your staged changes."
echo ""
while IFS="$(printf '\t')" read -r label hit advice; do
  echo "  * $label: $hit..."
  echo "      $advice"
  echo ""
done < "$findings"
echo "  Unstage it, move the value into .env.local, and commit again."
echo "  If this is genuinely not a secret: git commit --no-verify"
echo ""
exit 1
