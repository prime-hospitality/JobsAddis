#!/bin/sh
#
# The last chance to stop a credential before it becomes public.
#
# pre-commit only protects the machine it was installed on, and for most of this
# project's life only one of the two development machines had it -- which is how
# a service_role key reached this public repository on 2026-07-18. A commit made
# on an unprotected machine is caught here instead, because a push is the point
# at which a mistake stops being local.
#
# Scans every commit being pushed that GitHub does not already have. To bypass:
# git push --no-verify

hookdir=$(dirname "$0")
empty=0000000000000000000000000000000000000000
report=$(mktemp)
trap 'rm -f "$report"' EXIT

# stdin gives one line per ref being pushed: <local ref> <local sha> <remote ref> <remote sha>
while read -r _localref localsha _remoteref remotesha; do
  # A branch deletion pushes nothing and has nothing to scan.
  [ "$localsha" = "$empty" ] && continue

  if [ "$remotesha" = "$empty" ]; then
    # New branch: everything on it that is not already on some remote branch.
    revs=$(git rev-list "$localsha" --not --remotes)
  else
    revs=$(git rev-list "$remotesha".."$localsha")
  fi

  for rev in $revs; do
    git show --diff-filter=ACM -U0 --format= "$rev" \
      | grep '^+' \
      | sh "$hookdir/lib/scan-secrets.sh" >> "$report"
  done
done

[ -s "$report" ] || exit 0

echo ""
echo "  PUSH BLOCKED -- a credential appears in the commits you are pushing."
echo ""

# The same key in two commits is one problem, so collapse repeats -- but each
# finding is a two-line block, and sorting lines would separate every label from
# its advice. Paragraph mode dedupes whole blocks and keeps them in order.
awk 'BEGIN { RS = ""; ORS = "\n\n" } !seen[$0]++' "$report"
echo "  These are already committed, so unstaging is not enough. Rewrite the"
echo "  commit that introduced it:"
echo ""
echo "    git rebase -i <commit>^   # or: git reset --soft <commit>^"
echo ""
echo "  If this is genuinely not a secret: git push --no-verify"
echo ""
exit 1
