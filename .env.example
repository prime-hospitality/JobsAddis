# The two groups below go to different places. Copy only the first group into
# prime-hospitality/.env.local -- the second is read by Edge Functions through
# Deno.env, which means it comes from Supabase's own secret store and cannot be
# supplied by a file on your machine.
#
# `npm run doctor` checks the first group and names anything missing.
# Nothing here is ever committed with a real value in it.


# ═══ Group 1: prime-hospitality/.env.local ═══════════════════════════════════
# Needed to run the app locally. Also set in Vercel for the deployed app.

# ── Supabase (Frontend - publicly safe to expose) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Supabase (Backend - SECRET, never expose to the frontend) ────────────────
# Bypasses Row Level Security. Used by Next.js server actions.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Admin access (SECRET) ────────────────────────────────────────────────────
# Fallback super-admin password, used only until one is set in the app_config
# table from the dashboard. Set a real value before go-live -- the built-in
# fallback if this is unset is `admin123`.
ADMIN_PASSWORD=change_me_before_go_live

# Password for the internal /idp developer tracker page. The built-in fallback
# if this is unset is `changeme-idp`.
IDP_PASSWORD=change_me_before_go_live


# ═══ Group 2: Supabase -> Edge Functions -> Secrets ══════════════════════════
# Set once per project, in the dashboard. Putting these in .env.local does
# nothing -- Edge Functions run on Supabase and never see your local file.

# ── Supabase service key for Edge Functions (SECRET) ─────────────────────────
# The new-style key that outlives the legacy ones. _shared/serviceKey.ts falls
# back to the injected SUPABASE_SERVICE_ROLE_KEY when this is unset, so the
# functions keep working through a rotation.
SB_SECRET_KEY=your_supabase_secret_key_here

# ── Telegram (SECRET) ────────────────────────────────────────────────────────
# Used to validate Mini App initData (HMAC) and to send bot messages.
# NOTE: initData validation is keyed to this token. If it changes, the Mini App
# must be served from the matching bot or every job-seeker login fails.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Mini App deep link, used for "Open app" / "View & Apply" buttons.
# Format: https://t.me/<bot_username>/<app_short_name>
# If unset, announcements and DMs go out with no button (logged as an error) --
# there is deliberately no fallback URL.
TELEGRAM_MINI_APP_URL=https://t.me/your_bot/your_app

# Channel or group that new vacancies are announced to. The bot must be an
# admin there or posts silently fail. Usually negative, e.g. -1001234567890.
TELEGRAM_GROUP_CHAT_ID=your_channel_chat_id_here
