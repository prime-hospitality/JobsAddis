# Copy to prime-hospitality/.env.local and fill in real values.
# Anything marked SECRET must also be set in the hosting platform (Vercel) or
# in Supabase (Edge Functions -> Secrets) -- never committed.

# ── Supabase (Frontend - publicly safe to expose) ────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Supabase (Backend - SECRET, never expose to the frontend) ────────────────
# Bypasses Row Level Security. Used by Next.js server actions and Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Telegram (SECRET, set in Supabase Edge Function secrets) ─────────────────
# Used to validate Mini App initData (HMAC) and to send bot messages.
# NOTE: initData validation is keyed to this token. If it changes, the Mini App
# must be served from the matching bot or every job-seeker login fails.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Mini App deep link, used for "Open app" / "View & Apply" buttons.
# Format: https://t.me/<bot_username>/<app_short_name>
# If unset, announcements and DMs go out with no button (logged as an error) --
# there is deliberately no fallback URL.
TELEGRAM_MINI_APP_URL=https://t.me/your_bot/your_app

# Channel or group that new vacancies are announced to. The bot must be an
# admin there or posts silently fail. Usually negative, e.g. -1001234567890.
TELEGRAM_GROUP_CHAT_ID=your_channel_chat_id_here

# ── Admin access (SECRET) ────────────────────────────────────────────────────
# Fallback super-admin password, used only until one is set in the app_config
# table from the dashboard. Set a real value before go-live -- the built-in
# fallback if this is unset is `admin123`.
ADMIN_PASSWORD=change_me_before_go_live

# Password for the internal /idp developer tracker page.
IDP_PASSWORD=change_me_before_go_live
